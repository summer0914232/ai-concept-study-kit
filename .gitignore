# ============================================================
# 敏感信息：任何情况下都不要提交
# ============================================================
# 环境变量文件
.env
.env.*
*.env
env.local

# 密钥与证书
*.key
*.pem
*.p12
*.pfx
*.crt
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk

# 令牌 / API Key（含常见变体命名）
*.token
*token*.txt
*secret*
*credential*
*_api_key*
api-key*
apikey*
openai.key
anthropic.key
github-token*
.gh-token
.credentials
credentials.json
service-account*.json

# 云厂商配置目录
.aws/
.azure/
.gcloud/
.ssh/

# ============================================================
# 系统与编辑器
# ============================================================
.DS_Store
._*
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.example.json

# ============================================================
# 运行产物与缓存
# ============================================================
__pycache__/
*.py[cod]
node_modules/
dist/
build/
*.log
logs/
.cache/
.tmp/
tmp/
temp/

# ============================================================
# WorkBuddy 项目数据：只提交 skills，其余（记忆、会话缓存）忽略
# ============================================================
.workbuddy/*
!.workbuddy/skills/
!.workbuddy/skills/**

# ============================================================
# 个人文件与体积较大的二进制文件
# ============================================================
*.pdf
*.docx
*.pptx
*.xlsx
*.zip
*.rar
*.7z
*.mp4
*.mov
*.avi
*.psd
